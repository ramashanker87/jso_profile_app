# Frontend: copy frontend/.env.example to frontend/.env.local for local UI.
VITE_USE_MOCK_API=true
# Development server only; use with mock API disabled for the local Python backend.
VITE_USE_LOCAL_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-north-1
# Backend only. Never prefix secrets with VITE_.
AWS_REGION=eu-north-1
PROFILE_TABLE_NAME=profile-library-profiles
JOB_TABLE_NAME=profile-library-jobs
PROFILE_BUCKET_NAME=
NEETO_SECRET_ARN=
NEETO_API_BASE_URL=https://jso.neetoform.com/api/external/v1
NEETO_FORM_ID=4c47b1a6-144c-44ea-a6ce-0a151cdcb630
NEETO_API_KEY=
NEETO_WEBHOOK_SECRET=
NEETO_ATTACHMENT_HOSTS=app.neetoform.com,neeto-form-production-v3.s3.amazonaws.com
NEETO_FIELD_NAME=name
NEETO_FIELD_EMAIL=email
NEETO_FIELD_LINKEDIN=linkedin
NEETO_FIELD_SUPPORT="I'm willing to support this casue by"
# For an internal custom Theme column, use its field_id instead of its label.
NEETO_FIELD_THEME=theme
NEETO_FIELD_FILE=file_upload
MAX_PROFILE_FILE_SIZE_MB=20
DOCUMENT_URL_EXPIRY_SECONDS=900

# Set GOOGLE_SHEET_ID to switch manual sync to the member directory.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=1259657163
# Local service-account file; never commit credentials.
GOOGLE_APPLICATION_CREDENTIALS=
