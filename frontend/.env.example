VITE_USE_MOCK_API=true
# Development server only; use with mock API disabled for the local Python backend.
VITE_USE_LOCAL_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-north-1

# Google OAuth is enabled only after the Cognito provider is configured.
VITE_GOOGLE_LOGIN_ENABLED=false
VITE_COGNITO_OAUTH_DOMAIN=
VITE_COGNITO_REQUIRED_GROUP=
